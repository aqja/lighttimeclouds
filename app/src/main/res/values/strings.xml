    <!-- Weather summary -->
    <string name="summary_position_label">Weather summary</string>
    <string name="summary_position_left">Left</string>
    <string name="summary_position_right">Right</string>
    <string name="summary_position_hint">A few words on the weather: warnings, rain and snow, wind, clouds, the temperature compared with yesterday and in the coming hours, and in the evening tomorrow. Left or right of the clock needs a widget wider than it is tall.</string>
    <string name="summary_much_warmer">Much warmer than this time yesterday, up %1$d°.</string>
    <string name="summary_warmer">A bit warmer than this time yesterday.</string>
    <string name="summary_similar">About as warm as this time yesterday.</string>
    <string name="summary_cooler">A bit cooler than this time yesterday.</string>
    <string name="summary_much_colder">Much colder than this time yesterday, down %1$d°.</string>
    <string name="summary_feels_colder">Feels %1$d° colder than the thermometer says.</string>
    <string name="summary_feels_warmer">Feels %1$d° warmer than the thermometer says.</string>
    <!-- %1$s: when (e.g. "this evening"), %2$s: what falls, from summary_rain/summary_snow (e.g. "light rain"). -->
    <string name="summary_likely">%2$s likely %1$s.</string>
    <string name="summary_possible">%2$s possible %1$s.</string>
    <!-- The same for plural nouns (showers, gusts), where languages like French need "probables". -->
    <string name="summary_likely_plural">%2$s likely %1$s.</string>
    <string name="summary_possible_plural">%2$s possible %1$s.</string>
    <!-- %1$s: what is falling, from summary_rain_definite/summary_snow_definite (e.g. "the light rain"), %2$s: when. -->
    <string name="summary_stops">%1$s stops %2$s.</string>
    <string name="summary_lasts">%1$s goes on for many hours.</string>
    <!-- The same for plural nouns: the showers. -->
    <string name="summary_stops_plural">%1$s stop %2$s.</string>
    <string name="summary_lasts_plural">%1$s go on for many hours.</string>
    <!-- Fresh snow a spell leaves: from 0.5 cm, from 2 cm, from 10 cm. -->
    <string-array name="summary_fresh_snow">
        <item>A little fresh snow.</item>
        <item>A few centimeters of fresh snow.</item>
        <item>Lots of fresh snow.</item>
    </string-array>
    <!-- What falls, by its strongest hour, each in the order: below 0.5 mm per hour, up to 2.5, up to 10, above. -->
    <string-array name="summary_rain">
        <item>a little rain</item>
        <item>light rain</item>
        <item>rain</item>
        <item>heavy rain</item>
    </string-array>
    <string-array name="summary_snow">
        <item>a little snow</item>
        <item>light snow</item>
        <item>snow</item>
        <item>heavy snow</item>
    </string-array>
    <!-- Showers: with breaks or several spells. Steady: at least six hours without a break. -->
    <string-array name="summary_rain_showers">
        <item>a few showers</item>
        <item>light showers</item>
        <item>showers</item>
        <item>heavy showers</item>
    </string-array>
    <string-array name="summary_rain_showers_definite">
        <item>the showers</item>
        <item>the light showers</item>
        <item>the showers</item>
        <item>the heavy showers</item>
    </string-array>
    <string-array name="summary_rain_steady">
        <item>light steady rain</item>
        <item>light steady rain</item>
        <item>steady rain</item>
        <item>heavy steady rain</item>
    </string-array>
    <string-array name="summary_rain_steady_definite">
        <item>the light steady rain</item>
        <item>the light steady rain</item>
        <item>the steady rain</item>
        <item>the heavy steady rain</item>
    </string-array>
    <string-array name="summary_snow_showers">
        <item>a few snow showers</item>
        <item>light snow showers</item>
        <item>snow showers</item>
        <item>heavy snow showers</item>
    </string-array>
    <string-array name="summary_snow_showers_definite">
        <item>the snow showers</item>
        <item>the light snow showers</item>
        <item>the snow showers</item>
        <item>the heavy snow showers</item>
    </string-array>
    <string-array name="summary_snow_steady">
        <item>light steady snow</item>
        <item>light steady snow</item>
        <item>steady snow</item>
        <item>heavy steady snow</item>
    </string-array>
    <string-array name="summary_snow_steady_definite">
        <item>the light steady snow</item>
        <item>the light steady snow</item>
        <item>the steady snow</item>
        <item>the heavy steady snow</item>
    </string-array>
    <string-array name="summary_rain_definite">
        <item>the rain</item>
        <item>the light rain</item>
        <item>the rain</item>
        <item>the heavy rain</item>
    </string-array>
    <string-array name="summary_snow_definite">
        <item>the snow</item>
        <item>the light snow</item>
        <item>the snow</item>
        <item>the heavy snow</item>
    </string-array>
    <string name="summary_dry">Dry %1$s.</string>
    <!-- The strongest gusts, used with summary_possible_plural, by the DWD's levels: from 50, 62, 89, 103 and 118 km/h. -->
    <string-array name="summary_gusts">
        <item>strong gusts</item>
        <item>gale-force gusts</item>
        <item>severe gale gusts</item>
        <item>violent storm gusts</item>
        <item>hurricane-force gusts</item>
    </string-array>
    <!-- Heavy rain by the DWD's warning levels: from 15, 25 and 40 mm within one hour. -->
    <string name="summary_heavy_rain">Risk of heavy downpours %1$s.</string>
    <string name="summary_heavy_rain_severe">Risk of very heavy downpours %1$s.</string>
    <string name="summary_heavy_rain_extreme">Risk of extremely heavy downpours %1$s.</string>
    <!-- Rain at or below freezing. -->
    <string name="summary_freezing_rain">Risk of black ice %1$s.</string>
    <!-- Evening outlook on tomorrow's daytime. %1$s: temperature compared with today, %2$s: rain or snow. -->
    <string name="summary_tomorrow">Tomorrow %1$s, %2$s.</string>
    <!-- Tomorrow's highest temperature compared with today's: 5° and more lower, 2° and more lower, about
         the same, 2° and more higher, 5° and more higher. The cold variant for days below 10°. -->
    <string-array name="summary_tomorrow_temperature">
        <item>much cooler</item>
        <item>cooler</item>
        <item>about as warm</item>
        <item>warmer</item>
        <item>much warmer</item>
    </string-array>
    <string-array name="summary_tomorrow_temperature_cold">
        <item>much colder</item>
        <item>colder</item>
        <item>about as cold</item>
        <item>milder</item>
        <item>much milder</item>
    </string-array>
    <!-- How often it rains or snows tomorrow in the daytime: not at all, maybe, at times (up to 3 hours), often. -->
    <string-array name="summary_tomorrow_rain">
        <item>dry</item>
        <item>maybe a little rain</item>
        <item>rain at times</item>
        <item>rainy</item>
    </string-array>
    <string-array name="summary_tomorrow_snow">
        <item>dry</item>
        <item>maybe a little snow</item>
        <item>snow at times</item>
        <item>frequent snow</item>
    </string-array>
    <!-- %1$s: when, %2$s: a temperature with its degree sign (e.g. "−3°"). -->
    <string name="summary_clearing">Clearing up %1$s.</string>
    <string name="summary_clouding_over">Clouding over %1$s.</string>
    <string name="summary_overcast">Overcast %1$s.</string>
    <string name="summary_clear">Clear skies %1$s.</string>
    <string name="summary_heat">Hot %1$s, up to %2$s.</string>
    <string name="summary_heat_now">Hot, up to %1$s.</string>
    <string name="summary_frost">Frost %1$s, down to %2$s.</string>
    <string name="summary_lasting_frost">Below freezing %1$s, at most %2$s.</string>
    <!-- %2$d: degrees of change. -->
    <string name="summary_warming">%2$d° warmer %1$s.</string>
    <string name="summary_cooling">%2$d° colder %1$s.</string>
    <!-- Parts of the day in the weather summary, each in the order: early morning (5–9), morning
         (9–12), midday (12–14), afternoon (14–18), evening (18–22), night (22–5). Times are kept
         vague on purpose, an hourly forecast is not accurate to the hour. -->
    <string name="summary_time_soon">soon</string>
    <string-array name="summary_time_later">
        <item>later this morning</item>
        <item>later this morning</item>
        <item>over midday</item>
        <item>later this afternoon</item>
        <item>later this evening</item>
        <item>later tonight</item>
    </string-array>
    <string-array name="summary_time_at_today">
        <item>early this morning</item>
        <item>this morning</item>
        <item>around midday</item>
        <item>this afternoon</item>
        <item>this evening</item>
        <item>tonight</item>
    </string-array>
    <string-array name="summary_time_at_tomorrow">
        <item>early tomorrow morning</item>
        <item>tomorrow morning</item>
        <item>tomorrow around midday</item>
        <item>tomorrow afternoon</item>
        <item>tomorrow evening</item>
        <item>tomorrow night</item>
    </string-array>
    <string-array name="summary_time_from_today">
        <item>from early this morning</item>
        <item>from this morning</item>
        <item>from midday</item>
        <item>from this afternoon</item>
        <item>from this evening</item>
        <item>from tonight</item>
    </string-array>
    <string-array name="summary_time_from_tomorrow">
        <item>from early tomorrow morning</item>
        <item>from tomorrow morning</item>
        <item>from midday tomorrow</item>
        <item>from tomorrow afternoon</item>
        <item>from tomorrow evening</item>
        <item>from tomorrow night</item>
    </string-array>
    <string-array name="summary_time_until_today">
        <item>into the early morning</item>
        <item>into the morning</item>
        <item>until midday</item>
        <item>into the afternoon</item>
        <item>into the evening</item>
        <item>into the night</item>
